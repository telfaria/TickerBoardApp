<Window x:Class="TickerBoard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TickerBoard" Height="58" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="#111827"
        Loaded="OnLoaded" MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Window.Resources>
        <DataTemplate x:Key="QuoteTemplate">
            <Border Padding="18,0" BorderBrush="#334155" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Symbol}" Foreground="#E2E8F0" FontWeight="SemiBold" />
                        <!-- 長い銘柄名は切り詰めて表示幅を安定させる -->
                        <TextBlock Text="{Binding Name}" Foreground="#94A3B8" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="220" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding PriceDisplay}" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ChangeDisplay}" Foreground="{Binding ChangeBrush}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border Background="#111827" BorderBrush="#334155" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Right" Background="#1E293B" Padding="12,0" MouseLeftButtonDown="OnSettingsClick"><TextBlock VerticalAlignment="Center" Foreground="#CBD5E1" Text="⚙" /></Border>
            <Border DockPanel.Dock="Right" Background="#0F172A" Padding="12,0"><TextBlock VerticalAlignment="Center" Foreground="#94A3B8" Text="{Binding LastUpdatedText}" /></Border>
            <Grid x:Name="TickerGrid" ClipToBounds="True">
                <!-- テスト用のスクロールバーを再追加 -->
                <ScrollViewer x:Name="TickerScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" CanContentScroll="False">
                    <StackPanel x:Name="TickerStack" Orientation="Horizontal" RenderTransformOrigin="0,0">
                        <ItemsControl x:Name="QuotesControl1" ItemsSource="{Binding DisplayQuotes}" ItemTemplate="{StaticResource QuoteTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
